{
  "name": "leading-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Everything in Leading that runs inside WebKit: Markdown pipeline, reader, styles.",
  "scripts": {
    "proto": "node scripts/proto.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "stress": "node scripts/gen-stress.mjs",
    "bench": "node scripts/gen-stress.mjs && playwright test test/browser/bench.spec.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "decode-named-character-reference": "^1.3.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "trim-lines": "^3.0.1",
    "unist-util-visit-parents": "^6.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
