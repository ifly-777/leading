<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App extensions must be sandboxed. Quick Look grants read access to the file
     being previewed; nothing else on disk is reachable.

     network.client: WebKit will not start its page process inside a sandbox
     without it ("Application does not have permission to communicate with
     network resources"), even for a page that never uses the network. The
     preview makes no connection: the page's Content-Security-Policy forbids
     every network request, and the extension's only source of files is its
     own app bundle (PreviewViewController.swift, PageFiles). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.network.client</key><true/>
</dict>
</plist>
