# The one place the app's name, identity and version live.
# scripts/build-app.sh reads this to write Info.plist; the Swift code reads the
# name back from the bundle, and nothing else spells it out.
APP_NAME=Leading
BUNDLE_ID=io.github.ifly-777.leading
VERSION=1.0.1
BUILD=4
MIN_MACOS=26.0
# Where updates are announced (the GitHub release feed, once the repository is public).
SPARKLE_FEED=https://github.com/ifly-777/leading/releases/latest/download/appcast.xml
